{
  "name": "honk-downloader",
  "productName": "Honk Downloader",
  "version": "1.0.0",
  "description": "تطبيق سطح مكتب لتحميل الفيديو والصوت من أي موقع، مع متصفح مدمج.",
  "main": "src/main/main.js",
  "homepage": "https://github.com/ahmednacer/honk-downloader",
  "author": {
    "name": "Honk",
    "email": "ahmed@example.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.honk.downloader",
    "productName": "Honk Downloader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extensions",
        "to": "extensions",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "Honk <ahmed@example.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}
