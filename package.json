{
  "name": "wasel-downloader",
  "productName": "Wasel Downloader",
  "version": "2.0.0",
  "description": "Wasel Downloader — open-source premium video and Spotify audio downloader, no ads, no revenue. Built with Electron + yt-dlp/FFmpeg/spotdl.",
  "main": "src/main/main.js",
  "homepage": "https://github.com/ahmednacer/wasel-downloader",
  "author": {
    "name": "zerouki ahmed mouad (زروقي احمد معاذ)"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "check:mobile": "node mobile/scripts/check-mobile.js",
    "gen-icons": "node scripts/gen-icons.js",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "apk:prepare": "npm --prefix mobile run sync:web && npm --prefix mobile run android:sync && npm --prefix mobile run android:apply",
    "apk:build": "npm run apk:prepare && cd mobile/android && gradlew.bat assembleDebug"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.wasel.downloader",
    "productName": "Wasel Downloader",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "icons/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "extensions",
        "to": "extensions",
        "filter": ["**/*"]
      },
      {
        "from": "icons",
        "to": "icons",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wasel Downloader",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Wasel-Downloader-${version}-${arch}.exe",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "zerouki ahmed mouad"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.video",
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  }
}